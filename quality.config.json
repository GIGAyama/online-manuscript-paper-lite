{
  "_basePath": "manifest の id / scope / start_url に期待する値。独自ドメイン（CNAME あり）ではアプリはサブドメイン直下で配信されるので相対パス \"./\"。リポジトリ名の絶対パスに戻すと scope がページの URL を含まなくなり、PWA としてインストールできなくなる。",
  "basePath": "./",
  "initialJs": [
    "install-hook.js",
    "vendor/react.js",
    "vendor/react-dom.js",
    "vendor/sweetalert2.js",
    "js/icons.js",
    "js/app.js"
  ],
  "initialJsLimitBytes": 307200,
  "buildArtifacts": [
    "js/app.js",
    "js/icons.js",
    "css/style.css",
    "vendor/react.js",
    "vendor/react-dom.js",
    "vendor/sweetalert2.js"
  ],
  "imageLimits": {
    "default": 153600,
    "icons/icon-512.png": 61440,
    "icons/maskable-512.png": 61440,
    "favicon.png": 30720
  },
  "repoName": "online-manuscript-paper-lite",
  "sw": "static",
  "allowedRemoteScripts": [
    "^https://fonts\\.googleapis\\.com(/|$)",
    "^https://fonts\\.gstatic\\.com(/|$)"
  ]
}
